{
  "name": "rizon-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Rizon Wallet browser extension (Chromium, Manifest V3) — EVM + Solana, non-custodial.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-scripts.mjs",
    "build:fast": "vite build && node scripts/build-scripts.mjs",
    "dev": "node scripts/build-scripts.mjs --watch & vite build --watch --mode development",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@scure/bip32": "2.0.1",
    "@scure/bip39": "2.0.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "ethers": "6.16.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.21.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
