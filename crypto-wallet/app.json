{
  "expo": {
    "name": "Awarizon Wallet",
    "slug": "awarizon-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.awarizon.wallet"
    },
    "web": {
      "favicon": "./assets/favicon.jpg"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "borderColor": "#000000"
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "expo-navigation-bar": {
        "backgroundColor": "#000000",
        "borderColor": "#000000"
      },
      "eas": {
        "projectId": "de60bb7e-4611-4138-94c7-08df7a647b1f"
      }
    },
    "owner": "awarizon"
  }
}
