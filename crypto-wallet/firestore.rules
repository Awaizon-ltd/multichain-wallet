rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (see services/cloudBackup.js for the backup design)
service cloud.firestore {
  match /databases/{database}/documents {

    // One random 256-bit backup key per Firebase user. Only that user can
    // read it, and it can only be created — never changed or deleted from a
    // client — so a hijacked session can't swap the key and make the
    // existing Drive backup undecryptable.
    match /backupKeys/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key', 'v', 'createdAt'])
        && request.resource.data.key is string
        && request.resource.data.key.size() == 44   // base64 of 32 bytes
        && request.resource.data.v == 1;
      allow update, delete: if false;
    }

    // Everything else is closed by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
